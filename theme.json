{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1240px",
			"wideSize": "1360px"
		},
		"color": {
			"custom": true,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"name": "Cherry Orange (Primario)",
					"slug": "primary",
					"color": "#E47B02"
				},
				{
					"name": "Cherry Amber (Hover)",
					"slug": "primary-hover",
					"color": "#ED8F0C"
				},
				{
					"name": "Cherry Soft (Fondo Suave)",
					"slug": "primary-soft",
					"color": "#FFF7ED"
				},
				{
					"name": "Verde COD (Pago al Recibir)",
					"slug": "cod-green",
					"color": "#16A34A"
				},
				{
					"name": "Verde COD Oscuro",
					"slug": "cod-green-dark",
					"color": "#15803D"
				},
				{
					"name": "Verde COD Suave",
					"slug": "cod-green-soft",
					"color": "#F0FDF4"
				},
				{
					"name": "WhatsApp",
					"slug": "whatsapp",
					"color": "#25D366"
				},
				{
					"name": "Texto Principal (Oscuro)",
					"slug": "dark",
					"color": "#1F2933"
				},
				{
					"name": "Texto Secundario",
					"slug": "slate",
					"color": "#3E4C59"
				},
				{
					"name": "Texto Muted",
					"slug": "muted",
					"color": "#52606D"
				},
				{
					"name": "Borde Suave",
					"slug": "border",
					"color": "#E4E7EB"
				},
				{
					"name": "Fondo Claro",
					"slug": "surface",
					"color": "#F9F9FB"
				},
				{
					"name": "Fondo Alterno",
					"slug": "surface-alt",
					"color": "#F3F4F7"
				},
				{
					"name": "Blanco Puro",
					"slug": "white",
					"color": "#FFFFFF"
				}
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, sans-serif",
					"name": "Sans Principal",
					"slug": "sans"
				},
				{
					"fontFamily": "'Poppins', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
					"name": "Display / Títulos",
					"slug": "heading"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Pequeño",
					"slug": "xs",
					"size": "0.75rem"
				},
				{
					"name": "Pequeño",
					"slug": "sm",
					"size": "0.875rem"
				},
				{
					"name": "Base",
					"slug": "md",
					"size": "1rem"
				},
				{
					"name": "Grande",
					"slug": "lg",
					"size": "1.125rem",
					"fluid": {
						"min": "1rem",
						"max": "1.15rem"
					}
				},
				{
					"name": "Extra Grande",
					"slug": "xl",
					"size": "1.35rem",
					"fluid": {
						"min": "1.15rem",
						"max": "1.4rem"
					}
				},
				{
					"name": "2XL (Títulos Sección)",
					"slug": "2xl",
					"size": "2rem",
					"fluid": {
						"min": "1.5rem",
						"max": "2.25rem"
					}
				},
				{
					"name": "3XL (Hero)",
					"slug": "3xl",
					"size": "2.85rem",
					"fluid": {
						"min": "2rem",
						"max": "3rem"
					}
				}
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"name": "2XS",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "XS",
					"slug": "30",
					"size": "0.75rem"
				},
				{
					"name": "SM",
					"slug": "40",
					"size": "1rem"
				},
				{
					"name": "MD",
					"slug": "50",
					"size": "1.5rem"
				},
				{
					"name": "LG",
					"slug": "60",
					"size": "2.5rem"
				},
				{
					"name": "XL",
					"slug": "70",
					"size": "4rem"
				},
				{
					"name": "2XL",
					"slug": "80",
					"size": "5.5rem"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"name": "Sutil",
					"slug": "sm",
					"shadow": "0 2px 8px rgba(31, 41, 51, 0.05)"
				},
				{
					"name": "Tarjeta",
					"slug": "md",
					"shadow": "0 8px 24px rgba(31, 41, 51, 0.07)"
				},
				{
					"name": "Elevada",
					"slug": "lg",
					"shadow": "0 16px 36px rgba(31, 41, 51, 0.12)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--md)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "1.25rem",
				"bottom": "0px",
				"left": "1.25rem"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--dark)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--dark)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "10px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "600",
					"fontSize": "var(--wp--preset--font-size--md)"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"right": "1.5rem",
						"bottom": "0.8rem",
						"left": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-hover)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Cabecera Principal (Sin Carrito - Enfoque COD)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pie de Página Principal",
			"area": "footer"
		}
	]
}

